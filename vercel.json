{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {"src": "website-preview/**", "use": "@vercel/static"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"}
      ]
    }
  ],
  "rewrites": [
    {"source": "/", "destination": "/website-preview/index.html"},
    {"source": "/farmersville-tree-service", "destination": "/website-preview/farmersville-tree-service/index.html"},
    {"source": "/farmersville-tree-service/", "destination": "/website-preview/farmersville-tree-service/index.html"},
    {"source": "/tree-service-anna-tx", "destination": "/website-preview/tree-service-anna-tx/index.html"},
    {"source": "/tree-service-anna-tx/", "destination": "/website-preview/tree-service-anna-tx/index.html"},
    {"source": "/((?!website-preview/).*)", "destination": "/website-preview/$1"}
  ]
}